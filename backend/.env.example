# Copy this file to .env and fill in your local values.
#   cp .env.example .env
#
# .env is gitignored and must stay that way — it is the only place real
# credentials live. Nothing in here belongs in the frontend bundle: the
# browser never sees these values, it only ever holds a session cookie.

# ── Database ──────────────────────────────────────────────────────────────
# Neon pooled Postgres URL (the one the app uses for queries).
# On Render, set this in the service environment. Do not commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Direct (unpooled) URL, used by Prisma migrations:
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ── Session ───────────────────────────────────────────────────────────────
# Signs the session cookie. Must be at least 32 characters; the server
# refuses to start otherwise. Generate one with:
#   openssl rand -base64 48
# Rotating this value invalidates every existing session.
SESSION_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"

# ── Server ────────────────────────────────────────────────────────────────
# PORT=5000
# NODE_ENV=development
# LOG_LEVEL=debug

# Time zone months and days are counted in (IANA name).
# APP_TIMEZONE=Europe/Lisbon

# Origins allowed to call the API with credentials, comma-separated.
# In production set this to your real domain — never "*", which cannot be
# combined with cookies anyway.
# CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
