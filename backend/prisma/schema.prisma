generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                   Int           @id @default(autoincrement())
  firstName            String        @map("first_name")
  lastName             String        @map("last_name")
  birthday             DateTime?
  phoneNumber          String        @map("phone_number")
  email                String        @unique
  username             String        @unique
  // Nullable so the column can be added to an existing row without inventing
  // a credential. Login rejects an account whose password is unset; use
  // `npm run set-password` to set one.
  password             String?
  onboardingCompleted  Boolean       @default(false) @map("onboarding_completed")
  monthlyIncome        Decimal?      @map("monthly_income")
  currency             String        @default("EUR")
  financialGoal        String?       @map("financial_goal")
  monthlyExpenses      Decimal?      @map("monthly_expenses")
  fixedExpenses        Decimal?      @map("fixed_expenses")
  savingsTarget        Decimal?      @map("savings_target")
  employmentStatus     String?       @map("employment_status")
  budgetingExperience  String?       @map("budgeting_experience")
  createdAt            DateTime      @default(now()) @map("created_at")
  transactions         Transaction[]
  categoryBudgets      CategoryBudget[]
  investments          Investment[]

  @@map("users")
}

model CategoryBudget {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  monthlyLimit Decimal  @map("monthly_limit")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, category])
  @@map("category_budgets")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal
  category    String
  description String?
  date        DateTime @default(now())

  @@map("transactions")
}

model Investment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   // "stock", "etf", "crypto", "commodity"
  amount    Decimal
  buyPrice  Decimal  @map("buy_price")
  currency  String   @default("EUR")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("investments")
}
