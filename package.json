{
  "name": "personal-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "axios": "^1.18.1",
    "bootstrap": "^5.3.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router-dom": "6.30.1",
    "recharts": "^3.9.0",
    "undici": "^6.21.1",
    "webidl-conversions": "^8.0.1"
  },
  "scripts": {
    "build": "npm --prefix backend install && vite build",
    "start": "node backend/server.js",
    "start:frontend": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --prefix backend\" \"npm run start:frontend\"",
    "dev:all": "npm run dev",
    "set-password": "npm run --prefix backend set-password",
    "check:security": "npm run --prefix backend check:security",
    "test:backend": "npm test --prefix backend",
    "test:all": "npm run test && npm run test:backend",
    "create-user": "npm run --prefix backend create-user"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.3",
    "jsdom": "^24.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
